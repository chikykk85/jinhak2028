rules_version = '2';

// 2학년 진학 상담관리 — Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 이 내용을 통째로 붙여 넣고 [게시]하세요.
// ※ 관리자 이메일은 index.html 의 ADMIN_EMAIL 과 반드시 같아야 합니다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function isAdmin() {
      return signedIn() && myEmail() == 'jinhak.admin@example.com';
    }

    // 로그인한 담임교사의 학급 번호 (teachers/{이메일} 문서에서 읽음)
    function myClass() {
      return get(/databases/$(database)/documents/teachers/$(myEmail())).data.classNum;
    }

    function studentClass(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId)).data.classNum;
    }

    // 교사 계정 정보: 본인 문서만 읽기, 본인은 비밀번호 변경 표시만 수정 가능
    match /teachers/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && myEmail() == email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'pwUpdatedAt']));
    }

    // 학생 명단·성적: 관리자는 전체, 담임은 자기 반만 읽기 / 쓰기는 관리자만
    match /students/{studentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.classNum == myClass());
      allow write: if isAdmin();
    }

    // 상담 기록: 관리자는 전체, 담임은 자기 반 학생만 읽기·저장
    match /records/{studentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.classNum == myClass());
      allow create, update: if isAdmin()
        || (signedIn()
            && request.resource.data.classNum == myClass()
            && studentClass(studentId) == myClass());
      allow delete: if isAdmin();
    }

    // 그 밖의 문서는 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
